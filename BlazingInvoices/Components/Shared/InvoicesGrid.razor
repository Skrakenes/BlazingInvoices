@inject UiService UiService

<table class="min-w-full  text-sm">
    <thead>
        <tr class="border-b border-slate-600">
            <th class="py-2 text-center"></th>
            <th class="py-2 text-left">Invoice Number</th>
            <th class="py-2 text-left">Client</th>
            <th class="py-2 text-left">Issued on</th>
            <th class="py-2 text-left">Due on</th>
            <th class="py-2 text-center">Status</th>
            <th class="py-2 text-center">Action</th>
            <th class="py-2 text-right">Total Amount</th>
            <th class="py-2 text-center">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var invoice in Invoices)
        {
            <tr class="border-b border-slate-300 hover:bg-slate-50">
                <td class="py-2 text-center">
                    <div>
                        @if (invoice.IsPaid)
                        {
                            <button type="button"
                                    class="px-2 py-1 rounded border cursor-pointer border-indigo-100 bg-indigo-50  hover:bg-indigo-100 "
                                    title="View Invoice">
                                <img src="icons/eye.svg" />
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class=" px-2 py-1 rounded border cursor-pointer border-indigo-100 bg-indigo-50 hover:bg-indigo-100 "
                                    title="Preview Invoice">
                                <img src="icons/eye.svg" />
                            </button>
                        }
                    </div>
                </td>
                <td class="py-2 flex flex-col gap-2 justify-center items-start">
                    <label class="font-medium">@invoice.InvoiceNumber</label>
                    <button type="button"
                            class="underline text-blue-500 cursor-pointer hover:text-blue-800 hover:bg-blue-50"
                            @onclick="() => _showLineItemsForInvoiceId = invoice.Id">@invoice.LineItems.Count()
                        item(s)</button>
                    </td>
                    <td class="py-2 text-left">@invoice.ClientName</td>
                    <td class="py-2 text-left">@invoice.IssuedOn.ToString("dd-MMM-yyyy")</td>
                    <td class="py-2 text-left">@(invoice.DueOn?.ToString("dd-MMM-yyyy") ?? "NA")</td>

                    <td class="py-2 text-center">
                        <div class="flex justify-center items-center">
                            @if (invoice.IsPaid)
                            {
                                <label
                                class=" text-xs px-3 border border-green-200 bg-green-100 text-green-800 rounded-full">Paid</label>
                            }
                            else
                            {
                                <label
                                class="text-xs px-3 border border-amber-200 bg-amber-100 text-amber-800 rounded-full">Pending</label>
                            }
                        </div>
                    </td>

                    <td class="py-2 text-center">
                        <div class="flex justify-center items-center ">
                            @if (invoice.IsPaid)
                            {
                                <button type="button"
                                        class="  px-2 py-1 rounded border cursor-pointer border-red-100 bg-red-50 hover:bg-red-700 text-xs text-red-700 hover:text-white">Mark
                                    as Unpaid</button>
                                }
                                            else
                                {
                                    <button type="button"
                                            class=" text-xs px-2 py-1 rounded border cursor-pointer border-green-100 bg-green-50 text-green-700 hover:bg-green-700 hover:text-white">Mark
                                        as Paid</button>
                                    }
                                </div>
                            </td>

                            <td class="py-2 text-right">@invoice.TotalAmount.ToString("C")</td>
                            <td class="py-2 text-right">
                                <div class="flex gap-1 justify-end">

                                    @if (invoice.IsPaid)
                                    {
                                        @*<button type="button" class="px-2 py-1 rounded border cursor-pointer border-indigo-100
                                hover:bg-indigo-50 hover:border-indigo-700 " title="View Invoice">
                                                <img src="icons/eye.svg" />
                                            </button>*@
                                            
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class=" px-2 py-1 rounded border cursor-pointer border-blue-100 hover:bg-blue-100   "
                                                title="Edit Invoice">
                                            <img src="icons/pencil.svg" />
                                        </button>
                                        <button type="button"
                                                class=" px-2 py-1 rounded border cursor-pointer border-red-100 hover:bg-red-100  "
                                                title="Delete Invoice" @onclick="() => DeleteInvocie(invoice)">
                                            <img src="icons/x.svg" />
                                        </button>
                                        @*
                                            <button type="button" class=" px-2 py-1 rounded border cursor-pointer border-indigo-100
                                hover:bg-indigo-50 hover:border-indigo-700 " title="Preview Invoice">
                                                <img src="icons/eye.svg"/>
                                            </button>
                                            *@
                                    }

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_showLineItemsForInvoiceId > 0)
            {
                var invoice = Invoices.First(i => i.Id == _showLineItemsForInvoiceId.Value);

                <ViewLineItems Invoice="invoice" OnClose="() => _showLineItemsForInvoiceId = null" />
            }

@code {
    [Parameter, EditorRequired]
    public IEnumerable<InvoiceModel> Invoices { get; set; } = [];

    private int? _showLineItemsForInvoiceId;
    private void DeleteInvocie(InvoiceModel invoice)
    {
        var confirmationModel = ConfirmationModel.Create($"Do you want to delete invoice '{invoice.InvoiceNumber}'?", () =>
        {
            //Delete from db
        });

        UiService.Confirm(confirmationModel);
    }
}