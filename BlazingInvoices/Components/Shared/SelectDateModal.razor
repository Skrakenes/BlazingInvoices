<div class="fixed inset-0 z-40 flex items-center justify-center">
    <div class="fixed inset-0 bg-black/20"></div>
    <div class="z-40 flex flex-col items-center gap-3 rounded-lg bg-white p-5 shadow-2xl">
        <label class="font-medium text-xl">@Label</label>

        <input type="date" @bind="_date" class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-sm" />

        <div class="flex justify-between justify-center gap-3">
            <button type="button" class="cursor-pointer rounded border border-red-200 bg-red-50 px-3 py-1 text-red-600 hover:bg-red-100" @onclick="OnCancel">Cancel</button>
            <button type="button" class="cursor-pointer rounded border border-green-200 bg-green-50 px-3 py-1 text-green-600 hover:bg-green-100" @onclick="() => OnDateSelect.InvokeAsync(_date)">Select @_date.ToString("dd-MMM-YYYY")</button>
        </div>
    </div>
</div>


@code {
    [Parameter, EditorRequired]
    public string Label { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<DateTime> OnDateSelect { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnCancel { get; set; }

    private DateTime _date = DateTime.Now;
}
