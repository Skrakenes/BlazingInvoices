<aside class="flex w-72 flex-col border-r border-slate-200 bg-white">
    <nav class="flex-1 space-y-2 p-3">
        <NavLink href="dashboard" class="flex w-full items-center gap-3 rounded bg-slate-200 px-3 py-2 hover:bg-emerald-200">
            <img src="icons/layout-dashboard.svg" />
            <span class="font-medium">Dashboard</span>
        </NavLink>
        <NavLink href="invoices" class="flex w-full items-center gap-3 rounded bg-slate-200 px-3 py-2 hover:bg-emerald-200">
            <img src="icons/file.svg" />
            <span class="font-medium">Invoices</span>
        </NavLink>
        <NavLink href="clients" class="flex w-full items-center gap-3 rounded bg-slate-200 px-3 py-2 hover:bg-emerald-200">
            <img src="icons/users.svg" />
            <span class="font-medium">Clients</span>
        </NavLink>
        <NavLink href="services" class="flex w-full items-center gap-3 rounded bg-slate-200 px-3 py-2 hover:bg-emerald-200">
            <img src="icons/boxes.svg" />
            <span class="font-medium">Product/Services</span>
        </NavLink>
    </nav>

    <div class="border-t border-green-200 p-3">
        <div class="flex flex-col items-center justify-center gap-3 rounded p-3">
            <label class="font-medium">
                My Buisness
            </label>
            
            <button type="button" class="flex w-full cursor-pointer items-center justify-center gap-2 rounded border border-green-300 bg-green-100 px-3 py-2 hover:bg-green-200" 
                @onclick="ShowSettingMOdal">
                <img src="icons/settings.svg" />
                <span>Settings</span>
            </button>
        </div>
    </div>
</aside>

@if(_showSettingsModal)
{
    <SettingsFormModal OnClose="CloseSettingModal"/>
}

@code {
    private bool _showSettingsModal;

    private void ShowSettingMOdal()
    {
        _showSettingsModal = true;
    }
    private void CloseSettingModal()
    {
        _showSettingsModal = false;
    }

}