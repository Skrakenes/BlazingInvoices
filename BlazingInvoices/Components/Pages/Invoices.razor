@page "/invoices"

<div class="roudned-lg flex w-full flex-col bg-white p-5">
    <div class="flex items-center justify-between">
        <h1 class="text-xl font-medium">Invoice Management</h1>

        <button type="button"
                class="flex cursor-pointer items-center justify-center gap-2 rounded border border-green-300 bg-green-100 px-3 py-1 hover:bg-green-200">
            <img src="icons/plus.svg" />
            <span>Create Invoice</span>
        </button>
    </div>
    <hr class="mt-2 mb-5 w-full text-slate-400" />

    <div class="flex items-center w-full border-b border-slate-400">
        @foreach (var tab in _tabs)
        {
            string activeClasses = "";
            if (tab.IsActive)
            {
                activeClasses = $"border-b-2 bg-{tab.ActiveColor}-50 border-{tab.ActiveColor}-600 text-{tab.ActiveColor}-600";
            }
            <button type="button" class="cursor-pointer px-4 py-2 text-sm font-medium @activeClasses"
                    @onclick="() => ChangeTab (tab)">@tab.Name</button>
        }
    </div>
    <div class="mt-5">
        @if (!_invoices.Any())
        {
            <div class="m-5 p-5 text-center">
                <p class="text-3xl font-medium text-slate-500">No invoices created yet.</p>
            </div>
        }
        else
        {
            <div>
                <table class="min-w-full  text-sm">
                    <thead>
                        <tr class="border-b border-slate-600">
                            <th class="py-2 text-center"></th>
                            <th class="py-2 text-left">Invoice Number</th>
                            <th class="py-2 text-left">Client</th>
                            <th class="py-2 text-left">Issued on</th>
                            <th class="py-2 text-left">Due on</th>
                            <th class="py-2 text-center">Status</th>
                            <th class="py-2 text-center">Action</th>
                            <th class="py-2 text-right">Total Amount</th>
                            <th class="py-2 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var invoice in _invoices)
                        {
                            <tr class="border-b border-slate-300 hover:bg-slate-50">
                                <td class="py-2 text-center">
                                    <div>
                                     @if (invoice.IsPaid)
                                        {
                                            <button type="button" class="px-2 py-1 rounded border cursor-pointer border-indigo-100 bg-indigo-50  hover:bg-indigo-100 " title="View Invoice">
                                                <img src="icons/eye.svg"  />
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class=" px-2 py-1 rounded border cursor-pointer border-indigo-100 bg-indigo-50 hover:bg-indigo-100 " title="Preview Invoice">
                                                <img src="icons/eye.svg"/>
                                            </button>
                                        }
                                       </div>
                                </td>
                                    <td class="py-2 flex flex-col gap-2 justify-center items-start">
                                        <label class="font-medium">@invoice.InvoiceNumber</label>
                                        <button type="button"
                                            class="underline text-blue-500 cursor-pointer hover:text-blue-800 hover:bg-blue-50"
                                            @onclick="() => _showLineItemsForInvoiceId = invoice.Id">@invoice.LineItems.Count() item(s)</button>
                                    </td>
                                    <td class="py-2 text-left">@invoice.ClientName</td>
                                    <td class="py-2 text-left">@invoice.IssuedOn.ToString("dd-MMM-yyyy")</td>
                                    <td class="py-2 text-left">@(invoice.DueOn?.ToString("dd-MMM-yyyy") ?? "NA")</td>

                                    <td class="py-2 text-center">
                                       <div class="flex justify-center items-center">
                                         @if (invoice.IsPaid)
                                        {
                                            <label
                                            class=" text-xs px-3 border border-green-200 bg-green-100 text-green-800 rounded-full">Paid</label>
                                        }
                                        else
                                        {
                                            <label
                                            class="text-xs px-3 border border-amber-200 bg-amber-100 text-amber-800 rounded-full">Pending</label>
                                        }
                                       </div>
                                    </td>

                                    <td class="py-2 text-center">
                                        <div class="flex justify-center items-center ">
                                            @if (invoice.IsPaid)
                                        {
                                            <button type="button" class="  px-2 py-1 rounded border cursor-pointer border-red-100 bg-red-50 hover:bg-red-700 text-xs text-red-700 hover:text-white">Mark as Unpaid</button>
                                        }
                                        else
                                        {
                                            <button type="button" class=" text-xs px-2 py-1 rounded border cursor-pointer border-green-100 bg-green-50 text-green-700 hover:bg-green-700 hover:text-white">Mark as Paid</button>
                                        }
                                        </div>
                                    </td >

                                    <td class="py-2 text-right">@invoice.TotalAmount.ToString("C")</td>
                                    <td class="py-2 text-right">
                                        <div class="flex gap-1 justify-end">

                                        @if (invoice.IsPaid)
                                        {
                                           @*<button type="button" class="px-2 py-1 rounded border cursor-pointer border-indigo-100 hover:bg-indigo-50  hover:border-indigo-700 " title="View Invoice">
                                                <img src="icons/eye.svg"  />
                                            </button>*@
                                            
                                        }
                                        else
                                        {
                                            <button type="button" class=" px-2 py-1 rounded border cursor-pointer border-blue-100 hover:bg-blue-100   " title="Edit Invoice">
                                                <img src="icons/pencil.svg" />
                                            </button>
                                            <button type="button" class=" px-2 py-1 rounded border cursor-pointer border-red-100 hover:bg-red-100  " title="Delete Invoice">
                                                <img src="icons/x.svg" />
                                            </button>
                                            @*
                                            <button type="button" class=" px-2 py-1 rounded border cursor-pointer border-indigo-100 hover:bg-indigo-50 hover:border-indigo-700 " title="Preview Invoice">
                                                <img src="icons/eye.svg"/>
                                            </button>
                                            *@
                                        }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (_showLineItemsForInvoiceId > 0)
    {
        var invoice = _invoices.First(i => i.Id == _showLineItemsForInvoiceId.Value);
        <RightSidePanel Title="@(invoice.InvoiceNumber + "- Line Items")" OnClose="() => _showLineItemsForInvoiceId = null"
                        ShowSaveButton="false">
            <div class="">
                <table class="min-w-full  text-sm">
                    <thead>
                        <tr class="border-b border-slate-600">
                            <th class="py-2 text-left">Service</th>
                            <th class="py-2 text-left">Quantity x Rate</th>
                            <th class="py-2 text-left">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var li in invoice.LineItems)
                        {
                            <tr class="border-b border-slate-100">
                                <td class="p-2 text-left">@li.ServiceName</td>
                                <td class="p-2 text-left">
                                    @li.Quantity x @li.Rate.ToString("C") @li.Unit</td>
                                    <td class="p-2 text-left">@li.Amount.ToString("C")</td>
                                </tr>
                            }
                            <tr class="border-t border-slate-200">
                                <td colspan="2" class="p-2 text-right font-medium">Total Amount</td>
                                <td class="p-2 text-left">@invoice.TotalAmount.ToString("C")</td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </RightSidePanel>
        }

@code {

    private Tab[] _tabs = [
        new (InvoiceTabTypes.Recent, "indigo", true),
        new (InvoiceTabTypes.Pending, "amber"),
        new (InvoiceTabTypes.Paid, "emerald"),
        new (InvoiceTabTypes.All, "blue")
    ];

    private IEnumerable<InvoiceModel> _allInvoices = [];
    private IEnumerable<InvoiceModel> _invoices = [];

    private int? _showLineItemsForInvoiceId;

    protected override void OnInitialized()
    {
        _allInvoices = InvoiceSeeder.GetSeedInvoices();
        FilterInvoices(InvoiceTabTypes.Recent);
    }

    private void ChangeTab(Tab tab)
    {
        var currentActiveTab = _tabs.First(t => t.IsActive);
        currentActiveTab.IsActive = false;
        tab.IsActive = true;
        FilterInvoices(tab.Name);
    }

    private void FilterInvoices(string selectedTabName)
    {
        var filteredInvoices = selectedTabName switch
        {
            InvoiceTabTypes.Recent => _allInvoices.OrderByDescending(i=> i.Id).Take(5),
            InvoiceTabTypes.Pending => _allInvoices.Where(i=> !i.IsPaid),
            InvoiceTabTypes.Paid => _allInvoices.Where(i=> i.IsPaid),
            InvoiceTabTypes.All => _allInvoices.Take(10),
            _=> throw new InvalidOperationException()
        };

        _invoices = [.. filteredInvoices];
    }

    private class InvoiceTabTypes
    {
        public const string Recent = "Recent";
        public const string Pending = "Pending";
        public const string Paid = "Paid";
        public const string All = "All";
    }

    private class Tab
    {
        public Tab(string name, string activeColor, bool isActive = false) =>
            (Name, ActiveColor, IsActive) = (name, activeColor, isActive);

        public string Name { get; set; }
        public string ActiveColor { get; set; }
        public bool IsActive { get; set; }
    }
}

<div class="hidden ">
    <span class="bg-indigo-50 border-indigo-600 text-indigo-600"></span>
    <span class="bg-amber-50 border-amber-600 text-amber-600"></span>
    <span class="bg-emerald-50 border-emerald-600 text-emerald-600"></span>
    <span class="bg-blue-50 border-blue-600 text-blue-600"></span>
</div>