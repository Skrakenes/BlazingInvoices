@page "/invoices"

@inject InvoiceService InvoiceService
@inject UiService UiService

<div class="roudned-lg flex w-full flex-col bg-white p-5">
    <div class="flex items-center justify-between">
        <h1 class="text-xl font-medium">Invoice Management</h1>

        <NavLink href="invoices/create"
                 class="flex cursor-pointer items-center justify-center gap-2 rounded border border-green-300 bg-green-100 px-3 py-1 hover:bg-green-200">
            <img src="icons/plus.svg" />
            <span>Create Invoice</span>
        </NavLink>
    </div>
    <hr class="mt-2 mb-5 w-full text-slate-400" />

    <div class="flex items-center w-full border-b border-slate-400">
        @foreach (var tab in _tabs)
        {
            string activeClasses = "";
            if (tab.IsActive)
            {
                activeClasses = $"border-b-2 bg-{tab.ActiveColor}-50 border-{tab.ActiveColor}-600 text-{tab.ActiveColor}-600";
            }
            <button type="button" class="cursor-pointer px-4 py-2 text-sm font-medium @activeClasses"
                    @onclick="() => ChangeTab(tab)">@tab.Name</button>
        }
    </div>
    <div class="mt-5">
        @if (!_invoices.Any())
        {
            <div class="m-5 p-5 text-center">
                <p class="text-3xl font-medium text-slate-500">No invoices created yet.</p>
            </div>
        }
        else
        {
            <div>
                <InvoicesGrid Invoices="_invoices" />
            </div>
            <div class="w-full my-3 flex justify-between items-center">
            
            </div>
        }
    </div>
</div>


@code {

    [CascadingParameter(Name = nameof(MainLayout.UserId))]
    public required string UserId { get; set; }

    private Tab[] _tabs = [
        new (InvoiceTabTypes.Recent, "indigo", true),
        new (InvoiceTabTypes.Pending, "amber"),
        new (InvoiceTabTypes.Paid, "emerald"),
        new (InvoiceTabTypes.All, "blue")
    ];

    private int _pageNumber = 1;
    private int _pageSize = 10;
    private int _totalItems;

    private bool HasNextPage => _pageNumber * _pageSize < _totalItems;
    private bool HasPreviousPage => _pageNumber > 1;

    //private IEnumerable<InvoiceModel> _allInvoices = [];
    private IEnumerable<InvoiceModel> _invoices = [];

    protected override async Task OnInitializedAsync()
    {
        // _allInvoices = InvoiceSeeder.GetSeedInvoices();
        await FilterInvoices(InvoiceTabTypes.Recent);
    }

    private async Task ChangeTab(Tab tab)
    {
        var currentActiveTab = _tabs.First(t => t.IsActive);
        currentActiveTab.IsActive = false;
        tab.IsActive = true;
        await FilterInvoices(tab.Name);
    }

    private async Task FilterInvoices(string selectedTabName)
    {
        // var filteredInvoices = selectedTabName switch
        // {
        //     InvoiceTabTypes.Recent => _allInvoices.OrderByDescending(i => i.Id).Take(5),
        //     InvoiceTabTypes.Pending => _allInvoices.Where(i => !i.IsPaid),
        //     InvoiceTabTypes.Paid => _allInvoices.Where(i => i.IsPaid),
        //     InvoiceTabTypes.All => _allInvoices.Take(10),
        //     _ => throw new InvalidOperationException()
        // };

        // _invoices = [.. filteredInvoices];

        (_invoices, _totalItems) = await InvoiceService.GetInvoicesAsync(UserId, selectedTabName, _pageNumber, _pageSize);

    }

    private class Tab
    {
        public Tab(string name, string activeColor, bool isActive = false) =>
            (Name, ActiveColor, IsActive) = (name, activeColor, isActive);

        public string Name { get; set; }
        public string ActiveColor { get; set; }
        public bool IsActive { get; set; }
    }
}

<div class="hidden ">
    <span class="bg-indigo-50 border-indigo-600 text-indigo-600"></span>
    <span class="bg-amber-50 border-amber-600 text-amber-600"></span>
    <span class="bg-emerald-50 border-emerald-600 text-emerald-600"></span>
    <span class="bg-blue-50 border-blue-600 text-blue-600"></span>
</div>