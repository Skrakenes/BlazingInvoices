@implements IDisposable

@inject UiService UiService

@if(_show)
{
<div class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="fixed inset-0 bg-black/20"></div>
    <div class="z-50 flex items-center gap-3 rounded-lg bg-white p-5 shadow-2xl">
        <svg class="mr-3 -ml-1 size-5 animate-spin text-green-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            <label>@_loadingText</label>
    </div>
</div>
}

@code {
    private bool _show;
    private string _loadingText = "Loading";
    protected override void OnInitialized()
    {
        UiService.OnShowloader += HandleShowLoader;
        UiService.OnHideLoader += HandleHideLoader;
    }

    private void HandleShowLoader(string loadingText)
    {
        _loadingText = loadingText;
        _show = true;
        InvokeAsync(StateHasChanged);
    }
    private void HandleHideLoader()
    {
        _loadingText = "Loading";
        _show = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UiService.OnShowloader -= HandleShowLoader;
        UiService.OnHideLoader -= HandleHideLoader;
    }
}
