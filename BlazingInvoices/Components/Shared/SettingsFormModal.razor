<EditForm Model="_model" OnValidSubmit="HandleSaveAsync">
    <DataAnnotationsValidator />
    <div class="fixed inset-0 z-30 flex items-center justify-center">

        <div class="fixed inset-0 top-0 right-0 bottom-0 left-0 bg-black/20"></div>
        <div class="z-30 flex w-[550px] flex-col rounded-lg bg-white p-5 shadow-2xl">
            <div class="flex items-center justify-between">
                <h4 class="text-2xl font-medium">Settings</h4>
                <button type="button" class="rounded border border-slate-200 p-1" @onclick="OnClose">
                    <img src="icons/x.svg" />
                </button>
            </div>
            <hr class="mt-3 mb-5 text-slate-100" />

            <div class="space-y-3">
                <div class="">
                    <label class="text-xs text-slate-500">Buisness Name</label>
                    <InputText @bind-value="_model.BuisnessName"
                               class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-sm"
                               placeholder="Enter Buisness Name"></InputText>
                    <ValidationMessage For="() => _model.BuisnessName" class="text-xs text-red-500" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="">
                        <label class="text-xs text-slate-500">Email</label>
                        <InputText @bind-value="_model.Email"
                                   class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-sm"
                                   placeholder="Enter Email"></InputText>
                        <ValidationMessage For="() => _model.Email" class="text-xs text-red-500" />
                    </div>
                    <div class="">
                        <label class="text-xs text-slate-500">Contact Numnber</label>
                        <InputText @bind-value="_model.ContactNumber"
                                   class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-sm"
                                   placeholder="Enter Contact Number"></InputText>
                        <ValidationMessage For="() => _model.ContactNumber" class="text-xs text-red-500" />
                    </div>

                </div>
                <div class="">
                    <label class="text-xs text-slate-500">Address</label>
                    <InputTextArea rows="2" @bind-value="_model.Address"
                                   class="mt-1 w-full rounded-lg border border-slate-200 bg-slate-100 px-3 py-2 text-sm"
                                   placeholder="Enter Address"></InputTextArea>
                    <ValidationMessage For="() => _model.Address" class="text-xs text-red-500" />
                </div>
            </div>

            <hr class="mt-5 mb-3 text-slate-100" />
            <div class="flex items-center justify-end gap-7">
                <button type="button"
                        class="cursor-pointer rounded border border-red-200 bg-red-50 px-3 py-1 text-red-600 hover:bg-red-100"
                        @onclick="OnClose">Cancel</button>
                <button type="submit"
                        class="cursor-pointer rounded border border-green-200 bg-green-50 px-3 py-1 text-green-600 hover:bg-green-100"
                        ">Save</button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    private SettingsModel _model = new();

    private async Task HandleSaveAsync()
    {
        //Save settings in db
        await OnClose.InvokeAsync();
    }
}